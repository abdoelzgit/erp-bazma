generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EXECUTIVE
  FINANCE
  DEPT_HEAD
  STAFF
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum DepartmentMemberRole {
  PIC
  MEMBER
}

enum DepartmentMemberStatus {
  ACTIVE
  INACTIVE
}

enum PPDType {
  UANG_MUKA
  PEMBAYARAN
}

enum PPDStatus {
  DRAFT
  SUBMITTED
  APPROVED_DEPT
  APPROVED_FINANCE
  PAID
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departmentMemberships DepartmentMember[]
  ppdRequests           PPDRequest[]

  @@map("users")
}

model Department {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  status      DepartmentStatus @default(ACTIVE)
  picName     String?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members       DepartmentMember[]
  annualBudgets DepartmentAnnualBudget[]
  accounts      BudgetAccount[]
  ppdRequests   PPDRequest[]

  @@index([status, name])
  @@map("departments")
}

model DepartmentMember {
  id           String                 @id @default(cuid())
  departmentId String
  userId       String?
  name         String
  email        String
  role         DepartmentMemberRole   @default(MEMBER)
  status       DepartmentMemberStatus @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([departmentId, email])
  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

model DepartmentAnnualBudget {
  id              String   @id @default(cuid())
  departmentId    String
  year            Int
  allocatedAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, year])
  @@index([year])
  @@map("department_annual_budgets")
}

model BudgetAccount {
  id           String   @id @default(cuid())
  departmentId String
  code         String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  budgets    MonthlyBudget[]
  ppdItems   PPDItem[]

  @@unique([departmentId, code])
  @@unique([departmentId, name])
  @@index([departmentId, name])
  @@map("budget_accounts")
}

model MonthlyBudget {
  id              String   @id @default(cuid())
  accountId       String
  year            Int
  month           Int
  amount          Decimal  @db.Decimal(18, 2)
  realizedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, year, month])
  @@index([year, month])
  @@map("monthly_budgets")
}

model PPDRequest {
  id              String      @id @default(cuid())
  no              String      @unique
  title           String
  description     String?
  type            PPDType
  status          PPDStatus   @default(DRAFT)
  departmentId    String
  requestedById   String
  totalAmount     Decimal     @db.Decimal(18, 2)
  limitFund       Decimal     @default(0) @db.Decimal(18, 2)
  bankName        String?
  accountNo       String?
  accountName     String?
  paymentType     String      @default("Transfer")
  year            Int
  month           Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  department      Department  @relation(fields: [departmentId], references: [id])
  requestedBy     User        @relation(fields: [requestedById], references: [id])
  items           PPDItem[]

  @@map("ppd_requests")
  @@index([requestedById, updatedAt])
  @@index([year, month])
}

model PPDItem {
  id              String      @id @default(cuid())
  requestId       String
  accountId       String?
  description     String
  amount          Decimal     @db.Decimal(18, 2)
  attachmentUrl   String?
  createdAt       DateTime    @default(now())

  request         PPDRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  account         BudgetAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("ppd_items")
}
